                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"analyst_{{$randomInt}}@defense.gov\",\n  \"password\": \"SecureDefensePass123!\",\n  \"name\": \"Senior SIGINT Operator\"\n}"
            },
