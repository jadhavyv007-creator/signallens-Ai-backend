    {
      "name": "03. Signal Intelligence & DSP",
      "item": [
        {
          "name": "POST /api/v1/analyze (Multipart Signal Ingestion)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "sample_rate",
                  "value": "44100",
                  "type": "text"
                },
                {
                  "key": "carrier_freq_hz",
                  "value": "100000000",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/analyze",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analyze"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.expect(json.success).to.be.true;",
                  "pm.expect(json.data.metrics).to.exist;",
                  "pm.expect(json.data.visualizations).to.exist;",
                  "pm.expect(json.data.aiAnalysis).to.exist;",
                  "pm.expect(json.data.advanced).to.exist;"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
