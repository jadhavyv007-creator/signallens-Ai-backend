# ── Server Configuration ────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
HOST=0.0.0.0
DEBUG=false

# ── JWT Authentication ──────────────────────────────────────────────────
# Generate 64-char hex: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

# ── Database & Persistence ──────────────────────────────────────────────
# SQLite for zero-config local development, or PostgreSQL / Supabase connection string:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/signallens
DATABASE_URL=sqlite+aiosqlite:///./signallens.db

# ── Supabase (Optional) ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# ── CORS Allowlist (comma-separated origins) ────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Commercial Tier Upload Limits (in Megabytes) ────────────────────────
TIER_BASE_MAX_UPLOAD_MB=25
TIER_CYBER_PRO_MAX_UPLOAD_MB=500
TIER_SOVEREIGN_MAX_UPLOAD_MB=8192

# ── Billing & Payments ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_with_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_secret
UPI_PROVIDER_API_KEY=test_upi_key
VITE_ENABLE_PAYMENT_SIMULATION=true

# ── Monitoring & Logging (Optional) ──────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
